<resources>
    <style name="Theme.Pullar.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/coffee_bean</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Pullar</item>
    </style>

    <style name="Theme.Pullar" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/coffee_bean</item>
        <item name="android:navigationBarColor">@color/coffee_bean</item>
        <item name="android:windowBackground">@color/coffee_bean</item>
    </style>

    <style name="Theme.Pullar.Share" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
