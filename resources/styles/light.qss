/* ==========================================================================
   Simplest Video Downloader — Modern Flat Light Theme
   Strictly Solid Flat Colors (Zero Gradients)
   ========================================================================== */

* {
    font-family: "Segoe UI", "Segoe UI Variable", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* --- Window & Page Layout --- */
QMainWindow, QDialog {
    background-color: #f8fafc;
}

QWidget#centralWidget, QWidget#pageContainer {
    background-color: #f8fafc;
}

QScrollArea {
    background-color: #f8fafc;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #f8fafc;
}

/* --- Sidebar Navigation --- */
QWidget#sidebarContainer {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #475569;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 10px 16px;
    margin: 2px 8px;
}

QPushButton#navButton:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QPushButton#navButton:checked {
    background-color: #eff6ff;
    color: #2563eb;
    font-weight: 600;
}

/* --- Card Containers --- */
QFrame#cardFrame, QWidget#cardFrame {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 16px;
}

QFrame#downloadCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 14px;
}

QFrame#downloadCard:hover {
    border-color: #cbd5e1;
}

/* --- Inputs --- */
QLineEdit {
    background-color: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 9px 14px;
    color: #0f172a;
    font-size: 13.5px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 2px solid #2563eb;
}

QLineEdit::placeholder {
    color: #94a3b8;
}

QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    color: #0f172a;
    font-size: 13px;
    min-height: 22px;
}

QComboBox:focus, QSpinBox:focus {
    border: 1.5px solid #2563eb;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #e2e8f0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    selection-background-color: #eff6ff;
    selection-color: #2563eb;
    padding: 6px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 500;
    font-size: 13px;
    color: #334155;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
    color: #0f172a;
}

QPushButton:pressed {
    background-color: #f1f5f9;
}

QPushButton:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e2e8f0;
}

/* Primary Action Button */
QPushButton#primaryButton {
    background-color: #2563eb;
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-weight: 600;
    font-size: 13.5px;
    padding: 10px 22px;
    border-radius: 8px;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#primaryButton:pressed {
    background-color: #1e40af;
}

QPushButton#primaryButton:disabled {
    background-color: #93c5fd;
    border-color: #93c5fd;
    color: #ffffff;
}

/* Danger Button */
QPushButton#dangerButton {
    background-color: #ffffff;
    border: 1px solid #fca5a5;
    color: #ef4444;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #fef2f2;
    border-color: #ef4444;
}

/* Status Badges */
QLabel#statusDownloading {
    background-color: #f0fdf4;
    color: #16a34a;
    border: 1px solid #bbf7d0;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusCompleted {
    background-color: #eff6ff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusFailed {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusPaused {
    background-color: #fffbeb;
    color: #d97706;
    border: 1px solid #fde68a;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

/* --- Progress Bar --- */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #e2e8f0;
    height: 8px;
    text-align: right;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}

/* --- Table View --- */
QTableView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    selection-background-color: #eff6ff;
    selection-color: #0f172a;
    font-size: 12.5px;
    alternate-background-color: #f8fafc;
}

QTableView::item {
    padding: 8px 12px;
    border: none;
}

QTableView::item:selected {
    background-color: #e0e7ff;
    color: #1e1b4b;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    padding: 9px 12px;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1.5px solid #cbd5e1;
    font-weight: 600;
    font-size: 12px;
}

/* --- Media Player Panel --- */
QFrame#mediaPlayerPanel {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 12px;
}

/* Media Player Slider */
QSlider::groove:horizontal {
    height: 6px;
    background: #e2e8f0;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #2563eb;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #2563eb;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #1d4ed8;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar:horizontal {
    border: none;
    background: #f1f5f9;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
