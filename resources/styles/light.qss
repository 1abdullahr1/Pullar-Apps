/* ==========================================================================
   Pullar Desktop Theme — Flat Light
   Palette:
     Coffee Bean: #1a110f
     Light Apricot: #ffebc2
     Toffee Brown: #945e38
     Maya Blue: #7cc6fe
   Strictly Zero Emojis, Solid Colors
   ========================================================================== */

* {
    font-family: "Segoe UI", "Segoe UI Variable", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #1a110f;
    outline: none;
}

/* --- Window & Page Layout --- */
QMainWindow, QDialog {
    background-color: #fcf6ec;
}

QWidget#centralWidget, QWidget#pageContainer {
    background-color: #fcf6ec;
}

QScrollArea {
    background-color: #fcf6ec;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #fcf6ec;
}

/* --- Sidebar Navigation --- */
QWidget#sidebarContainer {
    background-color: #f7e4c6;
    border-right: 1px solid #e0c8a6;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #5c4033;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 10px 16px;
    margin: 2px 8px;
}

QPushButton#navButton:hover {
    background-color: #ffebc2;
    color: #1a110f;
}

QPushButton#navButton:checked {
    background-color: #ffebc2;
    color: #945e38;
    font-weight: 700;
    border-left: 3px solid #945e38;
}

/* --- Card Containers --- */
QFrame#cardFrame, QWidget#cardFrame {
    background-color: #ffffff;
    border: 1px solid #e5ccae;
    border-radius: 10px;
    padding: 16px;
}

QFrame#downloadCard {
    background-color: #ffffff;
    border: 1px solid #e5ccae;
    border-radius: 10px;
    padding: 14px;
}

QFrame#downloadCard:hover {
    border-color: #945e38;
}

/* --- Inputs --- */
QLineEdit {
    background-color: #ffffff;
    border: 1.5px solid #d4b896;
    border-radius: 8px;
    padding: 9px 14px;
    color: #1a110f;
    font-size: 13.5px;
    selection-background-color: #ffebc2;
    selection-color: #1a110f;
}

QLineEdit:focus {
    border: 2px solid #945e38;
}

QLineEdit::placeholder {
    color: #9c836e;
}

QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d4b896;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1a110f;
    font-size: 13px;
    min-height: 22px;
}

QComboBox:focus, QSpinBox:focus {
    border: 1.5px solid #945e38;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #e5ccae;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e5ccae;
    border-radius: 8px;
    selection-background-color: #ffebc2;
    selection-color: #945e38;
    padding: 6px;
}

QCheckBox {
    color: #1a110f;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #d4b896;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #945e38;
    border-color: #945e38;
}

/* --- Buttons --- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #d4b896;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 500;
    font-size: 13px;
    color: #1a110f;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #ffebc2;
    border-color: #945e38;
    color: #1a110f;
}

QPushButton:pressed {
    background-color: #f7dca8;
}

QPushButton:disabled {
    background-color: #fcf6ec;
    color: #cbb8a7;
    border-color: #e5ccae;
}

/* Primary Action Button (Toffee Brown) */
QPushButton#primaryButton {
    background-color: #945e38;
    border: 1px solid #7d4d2b;
    color: #ffebc2;
    font-weight: 700;
    font-size: 13.5px;
    padding: 10px 22px;
    border-radius: 8px;
}

QPushButton#primaryButton:hover {
    background-color: #804f2f;
    border-color: #945e38;
}

QPushButton#primaryButton:pressed {
    background-color: #6a3e21;
}

QPushButton#primaryButton:disabled {
    background-color: #d1b8a5;
    border-color: #d1b8a5;
    color: #f5ebe1;
}

/* Danger Button */
QPushButton#dangerButton {
    background-color: #ffffff;
    border: 1px solid #fca5a5;
    color: #b91c1c;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #fff1f2;
    border-color: #dc2626;
}

/* Platform Tag Pills */
QLabel#platformPill {
    background-color: #ffebc2;
    color: #1a110f;
    border: 1px solid #e0c8a6;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 600;
}

/* Quality Badge */
QLabel#qualityBadge {
    background-color: #eaf4fd;
    color: #1a110f;
    border: 1px solid #7cc6fe;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

/* Status Badges */
QLabel#statusDownloading {
    background-color: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusCompleted {
    background-color: #f0f8ff;
    color: #0284c7;
    border: 1px solid #7cc6fe;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusFailed {
    background-color: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusPaused {
    background-color: #fffbeb;
    color: #b45309;
    border: 1px solid #fde68a;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

/* --- Progress Bar --- */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #e5ccae;
    height: 8px;
    text-align: right;
}

QProgressBar::chunk {
    background-color: #945e38;
    border-radius: 4px;
}

/* --- Table View --- */
QTableView {
    background-color: #ffffff;
    border: 1px solid #e5ccae;
    border-radius: 8px;
    gridline-color: #f5e9d5;
    selection-background-color: #ffebc2;
    selection-color: #1a110f;
    font-size: 12.5px;
    alternate-background-color: #fcf9f2;
}

QTableView::item {
    padding: 8px 12px;
    border: none;
}

QTableView::item:selected {
    background-color: #ffebc2;
    color: #1a110f;
}

QHeaderView::section {
    background-color: #f7e4c6;
    color: #5c4033;
    padding: 9px 12px;
    border: none;
    border-right: 1px solid #e0c8a6;
    border-bottom: 1.5px solid #945e38;
    font-weight: 600;
    font-size: 12px;
}

/* --- Media Player Panel --- */
QFrame#mediaPlayerPanel {
    background-color: #ffffff;
    border: 1px solid #e5ccae;
    border-radius: 10px;
    padding: 12px;
}

/* Media Player Slider */
QSlider::groove:horizontal {
    height: 6px;
    background: #e5ccae;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #945e38;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #945e38;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #7d4d2b;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #fcf6ec;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #d4b896;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #945e38;
}

QScrollBar:horizontal {
    border: none;
    background: #fcf6ec;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #d4b896;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #945e38;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
