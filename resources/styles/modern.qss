/* ==========================================================================
   Pullar Desktop Theme — Modern Windows
   Palette:
     Coffee Bean: #1a110f
     Light Apricot: #ffebc2
     Toffee Brown: #945e38
     Maya Blue: #7cc6fe
   Strictly Zero Emojis, Solid Colors
   ========================================================================== */

* {
    font-family: "Segoe UI", "Segoe UI Variable", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #ffebc2;
    outline: none;
}

/* --- Window & Page Layout --- */
QMainWindow, QDialog {
    background-color: #1a110f;
}

QWidget#centralWidget, QWidget#pageContainer {
    background-color: #1a110f;
}

QScrollArea {
    background-color: #1a110f;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #1a110f;
}

/* --- Sidebar Navigation --- */
QWidget#sidebarContainer {
    background-color: #130c0a;
    border-right: 1px solid #3d261e;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #d4b69d;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 10px 16px;
    margin: 2px 8px;
}

QPushButton#navButton:hover {
    background-color: #2a1d19;
    color: #ffebc2;
}

QPushButton#navButton:checked {
    background-color: #33211b;
    color: #7cc6fe;
    font-weight: 700;
    border-left: 3px solid #7cc6fe;
}

/* --- Card Containers --- */
QFrame#cardFrame, QWidget#cardFrame {
    background-color: #241815;
    border: 1px solid #4a3026;
    border-radius: 10px;
    padding: 16px;
}

QFrame#downloadCard {
    background-color: #241815;
    border: 1px solid #4a3026;
    border-radius: 10px;
    padding: 14px;
}

QFrame#downloadCard:hover {
    border-color: #945e38;
}

/* --- Inputs --- */
QLineEdit {
    background-color: #130c0a;
    border: 1.5px solid #4a3026;
    border-radius: 8px;
    padding: 9px 14px;
    color: #ffebc2;
    font-size: 13.5px;
    selection-background-color: #7cc6fe;
    selection-color: #1a110f;
}

QLineEdit:focus {
    border: 2px solid #7cc6fe;
}

QLineEdit::placeholder {
    color: #8a7060;
}

QComboBox, QSpinBox {
    background-color: #130c0a;
    border: 1px solid #4a3026;
    border-radius: 8px;
    padding: 8px 12px;
    color: #ffebc2;
    font-size: 13px;
    min-height: 22px;
}

QComboBox:focus, QSpinBox:focus {
    border: 1.5px solid #7cc6fe;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #4a3026;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #130c0a;
    border: 1px solid #4a3026;
    border-radius: 8px;
    selection-background-color: #33211b;
    selection-color: #7cc6fe;
    padding: 6px;
}

QCheckBox {
    color: #ffebc2;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #4a3026;
    border-radius: 4px;
    background-color: #130c0a;
}

QCheckBox::indicator:checked {
    background-color: #7cc6fe;
    border-color: #7cc6fe;
}

/* --- Buttons --- */
QPushButton {
    background-color: #2a1d19;
    border: 1px solid #945e38;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 500;
    font-size: 13px;
    color: #ffebc2;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #3b2621;
    border-color: #b57447;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1a110f;
}

QPushButton:disabled {
    background-color: #1e1412;
    color: #5c433b;
    border-color: #2e1e1a;
}

/* Primary Action Button (Maya Blue) */
QPushButton#primaryButton {
    background-color: #7cc6fe;
    border: 1px solid #5cb2f6;
    color: #1a110f;
    font-weight: 700;
    font-size: 13.5px;
    padding: 10px 22px;
    border-radius: 8px;
}

QPushButton#primaryButton:hover {
    background-color: #9cd7ff;
    border-color: #7cc6fe;
}

QPushButton#primaryButton:pressed {
    background-color: #5cb2f6;
}

QPushButton#primaryButton:disabled {
    background-color: #3a5063;
    border-color: #3a5063;
    color: #7592a8;
}

/* Danger Button */
QPushButton#dangerButton {
    background-color: #2a1d19;
    border: 1px solid #7f1d1d;
    color: #fca5a5;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #450a0a;
    border-color: #ef4444;
}

/* Platform Tag Pills */
QLabel#platformPill {
    background-color: #2a1d19;
    color: #ffebc2;
    border: 1px solid #4a3026;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 600;
}

/* Quality Badge */
QLabel#qualityBadge {
    background-color: #241815;
    color: #7cc6fe;
    border: 1px solid #4a3026;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

/* Status Badges */
QLabel#statusDownloading {
    background-color: #16281d;
    color: #6ee7b7;
    border: 1px solid #234731;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusCompleted {
    background-color: #182838;
    color: #7cc6fe;
    border: 1px solid #2d4760;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusFailed {
    background-color: #331818;
    color: #fca5a5;
    border: 1px solid #572222;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#statusPaused {
    background-color: #332415;
    color: #fcd34d;
    border: 1px solid #573a1d;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
}

/* --- Progress Bar --- */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #2d1e1a;
    height: 8px;
    text-align: right;
}

QProgressBar::chunk {
    background-color: #7cc6fe;
    border-radius: 4px;
}

/* --- Table View --- */
QTableView {
    background-color: #1a110f;
    border: 1px solid #4a3026;
    border-radius: 8px;
    gridline-color: #33211c;
    selection-background-color: #33211b;
    selection-color: #7cc6fe;
    font-size: 12.5px;
    alternate-background-color: #241815;
}

QTableView::item {
    padding: 8px 12px;
    border: none;
}

QTableView::item:selected {
    background-color: #3d261e;
    color: #ffebc2;
}

QHeaderView::section {
    background-color: #130c0a;
    color: #d4b69d;
    padding: 9px 12px;
    border: none;
    border-right: 1px solid #33211c;
    border-bottom: 1.5px solid #945e38;
    font-weight: 600;
    font-size: 12px;
}

/* --- Media Player Panel --- */
QFrame#mediaPlayerPanel {
    background-color: #241815;
    border: 1px solid #4a3026;
    border-radius: 10px;
    padding: 12px;
}

/* Media Player Slider */
QSlider::groove:horizontal {
    height: 6px;
    background: #2d1e1a;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #7cc6fe;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #7cc6fe;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #9cd7ff;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #130c0a;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #4a3026;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #945e38;
}

QScrollBar::horizontal {
    border: none;
    background: #130c0a;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #4a3026;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #945e38;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
